AERIS_BACKEND_HOST=127.0.0.1
AERIS_BACKEND_PORT=4318
AERIS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Browser Use is launched lazily. Arguments must be a JSON string array.
AERIS_BROWSER_USE_COMMAND=uvx
AERIS_BROWSER_USE_ARGS=["--from","browser-use[cli]","browser-use","--cdp-url","http://127.0.0.1:9333","--mcp"]
AERIS_BROWSER_USE_TIMEOUT=30000

# The backend starts a shared Chromium session for Aeris Browser and Browser Use.
AERIS_CHROMIUM_CDP_PORT=9333
AERIS_CHROMIUM_HEADLESS=true
# AERIS_CHROMIUM_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# AERIS_CHROMIUM_PROFILE=/absolute/path/to/aeris-browser-profile
AERIS_BROWSER_VIEW_WIDTH=1280
AERIS_BROWSER_VIEW_HEIGHT=720
