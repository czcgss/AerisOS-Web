FUTURE_BACKEND_HOST=127.0.0.1
FUTURE_BACKEND_PORT=4318
FUTURE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Browser Use is launched lazily. Arguments must be a JSON string array.
FUTURE_BROWSER_USE_COMMAND=uvx
FUTURE_BROWSER_USE_ARGS=["--from","browser-use[cli]","browser-use","--cdp-url","http://127.0.0.1:9333","--mcp"]
FUTURE_BROWSER_USE_TIMEOUT=30000

# The backend starts a shared Chromium session for Future Browser and Browser Use.
FUTURE_CHROMIUM_CDP_PORT=9333
FUTURE_CHROMIUM_HEADLESS=true
# FUTURE_CHROMIUM_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# FUTURE_CHROMIUM_PROFILE=/absolute/path/to/future-browser-profile
FUTURE_BROWSER_VIEW_WIDTH=1280
FUTURE_BROWSER_VIEW_HEIGHT=720
